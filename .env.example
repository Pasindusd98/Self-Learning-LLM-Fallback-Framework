# Copy this file to .env and fill in real values. Never commit .env itself.

# Local Llama via Ollama (default fallback provider -- no API key needed)
# Install: https://ollama.com/download, then `ollama pull llama3.2`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: hosted LLM providers, if you swap the fallback away from Ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage
DATABASE_URL=postgresql+psycopg2://cascade:cascade@localhost:5432/cascade
# For quick local testing without Postgres, sqlite works too:
# DATABASE_URL=sqlite:///./cascade.db

# Vector store (used for novelty/OOD detection)
VECTOR_STORE_BACKEND=local   # local | qdrant | pgvector
QDRANT_URL=http://localhost:6333

# Framework behavior
LOG_LEVEL=INFO
